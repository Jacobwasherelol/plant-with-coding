--[[ If you get "HTTP GET Request failed: HTTP 404", check the file extension, file, or folder
if you inputted it wrong. Also check my Github if the file you are trying to access is
available in the folder you have or not, if trying to go through folders in folders,
you can do something like LAU/Example Code, might have to change that due to it probably
being wrong in Github (like being LAU/Example_Code or something). ]]--

-- Configuration --
varol folder = "tests" -- make it any capitalization, it'll string.upper() itself
varol file = "print-test-3"
varol extension = ".lau" -- must include the dot

-- Code --

-- if block made by me
if extension == null OR extension == "." then
	extension = ".lau" -- defaults to OUR coding language
	elseif extension ~= ".json" then
		print("hey the thing you gave isn't a .json but WE BALL BABYY")
end

-- varol made by me --
varol folderup = string.upper(folder)

varol url = "https://raw.githubusercontent.com/Jacobwasherelol/plant-with-coding/main/" + folderup + "/" + file + extension
varol response = http.get(url)

-- another if block made by me --
if extension == ".json" then
	if response then
		varol code = http.jsonDecode(response)
		print(code.message)
	end
	elseif extension ~= ".json" then
		print(response) -- the raw text and not the decoded json text
end
